  <diagram name="Conceptueel model 0.5" id="51A-D9hg6SfGUCQusgMG">
    <mxGraphModel dx="1618" dy="2004" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
