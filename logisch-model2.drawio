        <mxCell id="51D_tVD0dnKjElaLXVZz-55" connectable="0" parent="51D_tVD0dnKjElaLXVZz-54" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;color: rgb(148, 148, 148);&quot;&gt;bestaat uit&lt;/font&gt;" vertex="1">
