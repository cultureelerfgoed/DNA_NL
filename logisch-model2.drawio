        <mxCell id="0YQUh-IwNoFwUpvbhgRw-9" edge="1" parent="1" source="0YQUh-IwNoFwUpvbhgRw-5" style="endArrow=block;html=1;rounded=0;endFill=0;strokeColor=#949494;strokeWidth=1;startSize=6;endSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="0YQUh-IwNoFwUpvbhgRw-4" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="506" y="985" as="sourcePoint" />
            <mxPoint x="619" y="985" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="0YQUh-IwNoFwUpvbhgRw-10" connectable="0" parent="0YQUh-IwNoFwUpvbhgRw-9" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;color: rgb(148, 148, 148);&quot;&gt;beschrijft&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.0968" y="-4" as="geometry">
            <mxPoint x="-1" y="4" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="0YQUh-IwNoFwUpvbhgRw-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;figuur: conceptueel GM 0.9 basisentiteiten&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="211" x="127" y="938" as="geometry" />
        </mxCell>
        <mxCell id="0YQUh-IwNoFwUpvbhgRw-20" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Toelichting&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Aanpassing van 0.5 naar 0.9:&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;464&quot;&gt;&lt;b&gt;CHO&lt;/b&gt; is gewijzigd naar &lt;strong data-start=&quot;178&quot; data-end=&quot;185&quot;&gt;COR&lt;/strong&gt; om aan te geven dat het hier uitsluitend gaat om cultuurhistorische objecten die worden beschreven door de RCE. Dit sluit aan bij de DERA, waarin een cultuurhistorisch object (of erfgoedobject) wordt gedefinieerd als:&lt;br data-start=&quot;403&quot; data-end=&quot;406&quot;&gt;&lt;br&gt;&lt;em data-start=&quot;406&quot; data-end=&quot;464&quot;&gt;“Een object met een bepaalde cultuurhistorische waarde.”&lt;/em&gt;&lt;/p&gt;&lt;p data-start=&quot;466&quot; data-end=&quot;499&quot;&gt;Een &lt;span data-start=&quot;470&quot; data-end=&quot;498&quot;&gt;cultuurhistorisch object&lt;/span&gt;:&lt;/p&gt;&lt;ul data-start=&quot;500&quot; data-end=&quot;807&quot;&gt;&lt;li data-start=&quot;500&quot; data-end=&quot;692&quot;&gt;&lt;p data-start=&quot;502&quot; data-end=&quot;692&quot;&gt;kan materieel (bijvoorbeeld &lt;em data-start=&quot;530&quot; data-end=&quot;545&quot;&gt;De Nachtwacht&lt;/em&gt;), immaterieel (bijvoorbeeld een volksdans), conceptueel (bijvoorbeeld de Tweede Wereldoorlog) of digitaal (bijvoorbeeld een tweet van Trump) zijn;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;693&quot; data-end=&quot;741&quot;&gt;&lt;p data-start=&quot;695&quot; data-end=&quot;741&quot;&gt;bestaat, bestond of zou kunnen (gaan) bestaan;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;742&quot; data-end=&quot;807&quot;&gt;&lt;p data-start=&quot;744&quot; data-end=&quot;807&quot;&gt;kan zijn samengesteld uit meerdere cultuurhistorische objecten.&lt;/p&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;De term &lt;strong data-start=&quot;1501&quot; data-end=&quot;1523&quot;&gt;beeld-audio-object&lt;/strong&gt; is hernoemd naar &lt;strong data-start=&quot;1541&quot; data-end=&quot;1556&quot;&gt;beeldobject&lt;/strong&gt;, om de benaming beter te laten aansluiten bij de andere objecttypen.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Tussen &lt;strong data-start=&quot;816&quot; data-end=&quot;831&quot;&gt;tekstobject&lt;/strong&gt; en &lt;strong data-start=&quot;835&quot; data-end=&quot;850&quot;&gt;beeldobject&lt;/strong&gt; bevindt zich het &lt;strong data-start=&quot;868&quot; data-end=&quot;888&quot;&gt;informatieobject&lt;/strong&gt;.&lt;/div&gt;&lt;div&gt;Het &lt;span data-start=&quot;895&quot; data-end=&quot;915&quot;&gt;informatieobject&lt;/span&gt; volgt eveneens de definitie uit de DERA.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Een informatieobject:&lt;/div&gt;&lt;ul data-start=&quot;979&quot; data-end=&quot;1221&quot;&gt;&lt;li data-start=&quot;979&quot; data-end=&quot;1047&quot;&gt;&lt;p data-start=&quot;981&quot; data-end=&quot;1047&quot;&gt;bevat informatie over één of meerdere cultuurhistorische objecten;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1048&quot; data-end=&quot;1102&quot;&gt;&lt;p data-start=&quot;1050&quot; data-end=&quot;1102&quot;&gt;kan &lt;em data-start=&quot;1054&quot; data-end=&quot;1068&quot;&gt;digital born&lt;/em&gt;, gedigitaliseerd of analoog zijn;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1103&quot; data-end=&quot;1151&quot;&gt;&lt;p data-start=&quot;1105&quot; data-end=&quot;1151&quot;&gt;bestaat, bestond of zou kunnen (gaan) bestaan;&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;1152&quot; data-end=&quot;1221&quot;&gt;&lt;p data-start=&quot;1154&quot; data-end=&quot;1221&quot;&gt;kan zijn samengesteld uit meerdere informatieobjecten (aggregatie).&lt;/p&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;Een cultuurhistorisch object kan tevens een informatieobject zijn, en omgekeerd kan een informatieobject ook een cultuurhistorisch object zijn. Het &lt;em data-start=&quot;1371&quot; data-end=&quot;1397&quot;&gt;Plakkaat van Verlatinghe&lt;/em&gt; is hiervan een voorbeeld: dit is zowel een cultuurhistorisch object als een informatieobject.&lt;br&gt;&lt;p data-start=&quot;1493&quot; data-end=&quot;1625&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="659" width="400" x="297" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="JAj0l4w8eyUhgWt2NIwy-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Tekstobject" vertex="1">
          <mxGeometry height="60" width="120" x="218" y="519" as="geometry" />
        </mxCell>
        <mxCell id="JAj0l4w8eyUhgWt2NIwy-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#009900;" value="&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;Beeldobject&lt;/span&gt;" vertex="1">
