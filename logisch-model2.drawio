        <mxCell id="joUijgANzJyQ3Fsw0l-Q-10" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Analyseren van datastructuren en datavelden&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
