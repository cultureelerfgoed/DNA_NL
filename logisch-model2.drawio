        <mxCell id="1zmYVPA15mcJqpk_Rfmr-35" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Toelichting&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Aanpassing van 0.5 naar 0.9:&lt;/p&gt;&lt;p&gt;Laten vervallen entiteiten Begindatering en Einddatering.&amp;nbsp;Dit zorgde voor extra complexiteit bij het modelleren van tijdvakken en &lt;br&gt;het koppelen van datums aan gebeurtenissen, omdat voor elk tijdvak &lt;br&gt;meerdere joins nodig waren om de begin- en einddatum te achterhalen.&lt;br&gt;&lt;br&gt;Vanuit&lt;br&gt; het normalisatieprincipe is dit teruggebracht naar één enkele tabel: &lt;br&gt;Datering. In deze opzet worden begindatum en einddatum opgenomen als &lt;br&gt;attributen van de Datering-tabel, terwijl ook exacte datums en periodes &lt;br&gt;binnen dezelfde tabel kunnen worden vastgelegd.&lt;/p&gt;" vertex="1">
          <mxGeometry height="243" width="400" x="330" y="1742" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
