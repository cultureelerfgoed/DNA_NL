        </mxCell>
        <mxCell id="joUijgANzJyQ3Fsw0l-Q-11" value="I&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;teratieve feedback en bijstelling&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1627" y="253" width="161" height="30" as="geometry" />
        </mxCell>
        <mxCell id="joUijgANzJyQ3Fsw0l-Q-12" value="&lt;p&gt;&lt;strong&gt;Legenda&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Verzamelen van bestaande datamodellen en datastructuren voor geselecteerde datasets&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Inventariseren van beschikbare datasets en hun bestaande datamodellen.&lt;/li&gt;&lt;li&gt;In kaart brengen van datastructuren, datavelden en relaties.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;2️⃣ &lt;strong&gt;Analyseren van bestaande modellen en datastructuren&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Vergelijken van verschillende conceptuele en logische modellen.&lt;/li&gt;&lt;li&gt;Identificeren van inconsistenties, overlap en ontbrekende elementen.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;3️⃣ &lt;strong&gt;Opstellen van een gezamenlijk conceptueel model&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Creëren van een geharmoniseerd conceptueel model.&lt;/li&gt;&lt;li&gt;Afstemming met belanghebbenden over entiteiten en relaties.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;4️⃣ &lt;strong&gt;Analyseren van datastructuren, datavelden en attributen&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Identificeren van essentiële velden en hun relatie tot het conceptuele model.&lt;/li&gt;&lt;li&gt;Controleren op duplicaten, normalisatie en datatypeconsistentie.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;5️⃣ &lt;strong&gt;Opstellen van een gezamenlijk logisch model&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Vertalen van het conceptuele model en de datastructuur naar een logische database-opzet.&lt;/li&gt;&lt;li&gt;Definiëren van tabellen, sleutels en relaties.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;6️⃣ &lt;strong&gt;Technische validatie en optimalisatie&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Controleren van de database-opzet op prestatie, consistentie en schaalbaarheid.&lt;/li&gt;&lt;li&gt;Aanpassen van het model voor efficiëntie en betere query-performance.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;7️⃣ &lt;strong&gt;Implementatie en testen&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Het model implementeren in een testomgeving.&lt;/li&gt;&lt;li&gt;Testen op basis van echte data en gebruiksscenario’s.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;8️⃣ &lt;strong&gt;Iteratieve feedback en bijstelling&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Evaluatie van het model door gebruikers en ontwikkelaars.&lt;/li&gt;&lt;li&gt;Waar nodig terugkoppelen naar eerdere stappen voor aanpassingen.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-1618" y="825" width="617" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
