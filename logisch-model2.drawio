        <mxCell id="XvaZ9UBKLbnFgR-8Pnwm-112" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Toelichting&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Aanpassing van 0.5 naar 0.9:&lt;/p&gt;&lt;p&gt;Attribuut bouwkundige_staat in &lt;i&gt;Archeologische_kwaliteit&lt;/i&gt; is vervangen door &lt;i&gt;fysieke_staat&lt;/i&gt; in &lt;i&gt;Fysieke_kwaliteit&lt;/i&gt;&lt;i&gt;.&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p&gt;Attribuut &lt;i&gt;objectkwaliteit&lt;/i&gt; is niet opgenomen, kent geen waarde.&lt;/p&gt;&lt;p&gt;Attribuut &lt;i&gt;dimensietype&lt;/i&gt; in&lt;i&gt; Dimensie &lt;/i&gt;is gewijzigde in &lt;i&gt;fysiek_kenmerktype&lt;/i&gt; vanwege wijziging entiteit van &lt;i&gt;Dimensie&lt;/i&gt; naar &lt;i&gt;Fysiek_kenmerk&lt;/i&gt;.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Attributen uit entiteiten&amp;nbsp;&lt;i&gt;Soort, Zoologische soort, Botanische soort, Maritiem&lt;/i&gt; en &lt;i&gt;Speciale_depositie/Graf niet opgenomen vanwege vervallen van genoemde entiteiten.&lt;/i&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="303" width="400" x="-4431" y="-8586" as="geometry" />
        </mxCell>
        <mxCell id="nAB5KoRj8BSe-N5FY5b2-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Text" vertex="1">
