        <mxCell id="439ihWkRNYcleCyDN3x_-84" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Toelichting&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Aanpassing naar 0.9:&lt;/p&gt;&lt;div&gt;Toegevoegd entiteit&lt;i&gt; &lt;/i&gt;&lt;b&gt;Informatieobject&lt;/b&gt;, zie uitleg bij Conceptueel GM 0.5 Informatieobject.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Gewijzigd entiteit&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;b&gt;Beeld-audio-visueel object&lt;/b&gt;, zie uitleg bij Conceptueel GM 0.5 Informatieobject.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Laten vervallen zijn entiteiten&lt;i&gt; &lt;/i&gt;&lt;b&gt;Afbeelding&lt;/b&gt;&lt;i&gt; &lt;/i&gt;en &lt;b&gt;Audio-visueel materiaal&lt;/b&gt;&lt;i&gt;. &lt;/i&gt;Op dit moment nemen we geen audiovisueel materiaal op, daarom is er nu een entiteit Beeldobject. (Normalisatie)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Entiteiten &lt;b&gt;Digitaal &lt;/b&gt;en &lt;b&gt;Analoog&lt;/b&gt; is gewijzigd in &lt;b&gt;Digitaal object &lt;/b&gt;en &lt;b&gt;Analoog object&amp;nbsp;&lt;/b&gt;gekoppeld aan Beeldobject en Tekstobject omdat beiden een fysieke als digitale versie kan hebben. (Normalisatie)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Laten vervallen de entiteit &lt;b&gt;Opdracht &lt;/b&gt;gekoppeld aan &lt;b&gt;Digitaal&lt;/b&gt;, opdracht voor bijvoorbeeld foto hoort niet in het Generiek datamodel. (Normalisatie)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Laten vervallen entiteit &lt;b&gt;Uitsluitingsverzoek&lt;/b&gt;, dit proces is niet zinvol voor Generiek model. (Normalisatie)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Laten vervallen &lt;b&gt;Geografische aanduiding &lt;/b&gt;die gekoppeld is aan &lt;b&gt;Audio-visueel materiaal &lt;/b&gt;deze is vervangen door &lt;b&gt;Locatie&lt;/b&gt;&lt;i&gt; &lt;/i&gt;gekoppeld aan Informatieobject daardoor ge-unformeerd zodat aan ieder informatieobject een locatie kan worden gekoppeld. (Normalisatie)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Toegevoegd is entiteit &lt;b&gt;Thesaurus &lt;/b&gt;&lt;i&gt;o&lt;/i&gt;m te verwijzen naar termen uit thesaurus en type trefwoord aan te geven. (Normalisatie)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Toegevoegd entiteitenmodel &lt;b&gt;Betrokkene&lt;/b&gt; om persoon of organisatie te koppelen aan een informatieobject en rol vast te leggen op een uniforme manier, zie bij Kennisregistratie. (Normalisatie)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Laten vervallen &lt;b&gt;Vervaardiger&lt;/b&gt; gekoppeld aan Beeld-audio-visueel object, zie als verklaring hierboven Betrokkene. (Normalisatie)&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="590" width="400" x="332" y="1834" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
