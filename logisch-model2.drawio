        <mxCell id="0YQUh-IwNoFwUpvbhgRw-8" connectable="0" parent="0YQUh-IwNoFwUpvbhgRw-7" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;color: rgb(148, 148, 148);&quot;&gt;beschrijft&lt;/font&gt;" vertex="1">
